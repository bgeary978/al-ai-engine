# Copy to Render Environment (and to a local .env). Do not commit real keys.

# --- Ollama on your PC, reached from Render via ngrok ---
# On the PC:  ollama serve   (llama3.1 pulled)
#             ngrok http 11434
# Paste the https forwarding URL with no trailing slash:
OLLAMA_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
OLLAMA_MODEL=llama3.1
AFFORDABILITY_LLM=ollama

# --- Cloud crews (valuation + market = Groq, strategist = OpenAI) ---
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Market search ---
SERPER_API_KEY=

# --- Valuation model on Hugging Face (used by /predict and /assess-valuation) ---
HF_MODEL_REPO=
HF_TOKEN=

CREW_VERBOSE=0
